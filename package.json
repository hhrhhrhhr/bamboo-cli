{
  "name": "bamboo-cli",
  "version": "2.0.0",
  "private": true,
  "description": "Bamboo command-line wrappers for Claude Code and Codex",
  "scripts": {
    "build": "pnpm build:core && pnpm build:claude && pnpm build:codex",
    "build:core": "pnpm --filter @bamboo/core build",
    "build:claude": "pnpm --filter @bamboo/claude build",
    "build:codex": "pnpm --filter @bamboo/codex build",
    "release": "pnpm build && bash scripts/release.sh"
  },
  "keywords": [
    "bamboo",
    "claude",
    "codex",
    "llm",
    "cli"
  ],
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@10.24.0+sha512.01ff8ae71b4419903b65c60fb2dc9d34cf8bb6e06d03bde112ef38f7a34d6904c424ba66bea5cdcf12890230bf39f9580473140ed9c946fef328b6e5238a345a"
}
